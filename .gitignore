# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# --- Terraform ---------------------------------------------------------
# Downloaded provider binaries — hundreds of MB, and re-fetched by
# `terraform init`. Never belongs in version control.
**/.terraform/

# State files can contain secrets in plaintext (DB passwords, connection
# strings). Keep them in remote state, never in the repo.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Variable files typically hold credentials (see var.db_password).
*.tfvars
*.tfvars.json

# Saved plans can also embed sensitive values.
*.tfplan

# --- Editors / OS ------------------------------------------------------
/.elixir_ls/
/.lexical/
.DS_Store
Thumbs.db

